# Copy to .env. Default offline mode needs no API credential.
MODEL_MODE=offline
DEMO_AUTH=true
AUTH_SECRET=replace-with-a-long-random-local-secret
MCP_SERVICE_SECRET=replace-with-a-different-long-random-secret
# MODEL_MODE=online requires credentials and CHAT_MODEL below.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://your-compatible-provider.example/v1
# CHAT_MODEL=your-chat-model
EMBEDDING_MODEL=BAAI/bge-m3
# The configured provider must serve this embedding model; its API model ID may differ.
# DATABASE_URL=postgresql://medical:medical_demo@localhost:5432/medical
# MCP_HTTP_URL=http://localhost:8001/mcp
# MCP_FAULT_AFTER_COMMIT=true
